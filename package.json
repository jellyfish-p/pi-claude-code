{
  "name": "pi-claude-native-tools",
  "version": "0.1.1",
  "type": "module",
  "description": "Expose Claude Code native Read/Write/Bash/Edit/Grep tools when the active model id contains claude",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellyfish-p/pi-claude-code.git"
  },
  "homepage": "https://github.com/jellyfish-p/pi-claude-code#readme",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jellyfish-p/pi-claude-code/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "extensions"
  ],
  "pi": {
    "extensions": [
      "./extensions/claude-native-tools/index.ts"
    ]
  },
  "scripts": {
    "generate:claude-tools": "node scripts/generate-claude-tools.mjs",
    "test": "node --experimental-strip-types --test test/translate.test.ts test/replace-all.test.ts test/release.test.ts",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
