{
  "name": "pi-claude-native-tools",
  "version": "0.3.0",
  "type": "module",
  "description": "Claude Code Read/Write/Bash/Edit/Grep/Glob tool profile for pi with auto, off, and force modes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellyfish-p/pi-claude-code.git"
  },
  "homepage": "https://github.com/jellyfish-p/pi-claude-code#readme",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jellyfish-p/pi-claude-code/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "extensions"
  ],
  "pi": {
    "extensions": [
      "./extensions/claude-native-tools/index.ts"
    ]
  },
  "scripts": {
    "generate:claude-tools": "node scripts/generate-claude-tools.mjs",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "prepublishOnly": "npm test",
    "test:integration": "node --experimental-strip-types --test test/integration.test.ts",
    "capture": "node scripts/capture/capture.mjs",
    "diff:catalog": "node scripts/catalog-diff.mjs",
    "collect": "node scripts/collect.mjs",
    "build:docs": "node scripts/build-docs.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.6.0 <1.7.0",
    "@earendil-works/pi-coding-agent": ">=1.6.0 <1.7.0",
    "typebox": ">=1.3.27 <1.4.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.1"
  },
  "dependencies": {
    "minimatch": "11.0.9"
  }
}
